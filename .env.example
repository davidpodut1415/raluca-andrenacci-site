# Copy to .env for local development. Never commit .env.
# Every variable added here must also be validated in apps/api/src/config/env.ts and listed in render.yaml.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Local Postgres from docker-compose.yml
DATABASE_URL=postgresql://raluca:raluca@localhost:5432/raluca

# Public origin of the site (used for canonical URLs, sitemap, CORS in dev)
PUBLIC_SITE_URL=http://localhost:5173

# Web (build-time, VITE_-prefixed values are public)
# Origin used for canonical/hreflang URLs; empty = current origin
VITE_SITE_URL=
# Google Tag Manager container id; loaded only after cookie consent. Leave empty in dev.
VITE_GTM_ID=
